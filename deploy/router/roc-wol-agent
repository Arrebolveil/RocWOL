#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    test -s /etc/roc-wol/agent.json || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/roc-wol-agent --config /etc/roc-wol/agent.json
    procd_set_param user root
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="0 0"
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger roc-wol
}

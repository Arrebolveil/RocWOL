#!/bin/sh /etc/rc.common
START=94
STOP=11
USE_PROCD=1

start_service() {
    test -s /etc/roc-wol/frpc.toml || return 1
    @FRPC_PATH@ verify -c /etc/roc-wol/frpc.toml >/dev/null || return 1
    procd_open_instance
    procd_set_param command @FRPC_PATH@ -c /etc/roc-wol/frpc.toml
    procd_set_param user root
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="0 0"
    procd_close_instance
}
